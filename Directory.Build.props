<Project>

  <!--
    Zentrale Versionsquelle für alle Projekte (Phase 9a). MSBuild importiert diese
    Datei automatisch in jede .csproj unterhalb des Repo-Roots, daher tragen alle
    Assemblies (API, Client, Domain, Data, Shared) dieselbe Version.

    Version anheben = nur die Zeile <Version> unten ändern, am besten über den Claude-Skill
    /release (Version, CHANGELOG, Tag vX.Y.Z, GitHub-Release).
    <Version> setzt AssemblyVersion (X.Y.Z.0), FileVersion und InformationalVersion (X.Y.Z).

    Was jede Version enthält – auch die Zeit vor dem Livegang, als die Minor-Version die
    Phasen zählte – steht in CHANGELOG.md. Seit dem Livegang (27.08.2026) gilt SemVer.
  -->
  <PropertyGroup>
    <Version>1.3.0</Version>
    <Product>HorizonNET</Product>
  </PropertyGroup>

  <!-- Gemeinsame Compiler-Einstellungen aller Projekte (früher in jeder .csproj einzeln).
       TargetFramework bleibt bewusst in den .csproj, damit jedes Projekt auf einen Blick
       zeigt, wofür es gebaut wird. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Der Build ist warnungsfrei und soll es bleiben: Jede neue Warnung bricht ihn ab,
         auch NuGetAudit-Meldungen (NU1902/NU1903) zu neu bekannt gewordenen Lücken. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
