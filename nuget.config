<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Nur nuget.org, unabhängig von den Quellen, die auf dem jeweiligen Rechner global
       eingetragen sind. Das Source Mapping legt fest, dass jedes Paket ausschließlich von
       dort kommt (Schutz vor Dependency Confusion). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
