<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Updater für den vServer (ADR 0007, docs/konzept-auto-update.md). Läuft als geplante Aufgabe
    unter SYSTEM, lädt das Paket des neuesten GitHub-Releases, tauscht app\, tools\ und updater\
    und rollt bei einem Fehler Programm und DB zurück.

    Im Paket liegt er als eine einzige, komprimierte Datei, self-contained (deploy-package.ps1
    gibt -r win-x64 und self-contained vor). Nicht getrimmt: Mit dem gepinnten Runtime-Patch
    bräuchte ILLink genau diese Runtime auf dem Build-Rechner (wie beim WASM-Client, siehe
    .claude/rules/build.md). JSON trotzdem quellgeneriert (UpdaterJson).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Self-contained Deployment-Paket: Runtime-Patch wie die API (Erklärung in HorizonNET.Api.csproj). -->
  <PropertyGroup Condition="'$(HorizonRuntimeVersion)' != ''">
    <RuntimeFrameworkVersion>$(HorizonRuntimeVersion)</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paketregeln (Dateinamen, Release-Auswahl) und status.json teilt er mit der API. -->
    <ProjectReference Include="..\..\Shared\HorizonNET.Shared.Transfer\HorizonNET.Shared.Transfer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HorizonNET.Server.Tests" />
  </ItemGroup>

</Project>
