<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Kein OverrideHtmlAssetPlaceholders: Die Platzhalter-Transformation der index.html
         läuft nur beim Publish DIESES Projekts – beim Same-Origin-Publish über die API
         bliebe der rohe Platzhalter stehen und die App bootet nicht. Stattdessen stehen
         Klarnamen in der index.html; MapStaticAssets bedient sie in Dev wie in Produktion
         (die gehashten Framework-Interna lädt blazor.webassembly.js über sein eigenes
         Boot-Manifest, dafür braucht es keine Importmap). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.10" />
    <PackageReference Include="Radzen.Blazor" Version="11.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\HorizonNET.Shared.Transfer\HorizonNET.Shared.Transfer.csproj" />
  </ItemGroup>

</Project>
