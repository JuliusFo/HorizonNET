@* Abgeleiteter Ordnerbaum der Notizen (Arbeitsbereich → Projekt → Task).
   Die Blätter rendern die vorhandene NoteList weiter – dadurch sehen Auswahl, Snippet
   und Zeichnungs-Vorschau aus wie in der flachen Liste, und die Komponente bleibt an
   den anderen Einsatzorten (Task- und Projekt-Detailseite) unangetastet.

   Die Komponente ruft sich für Unterebenen selbst auf. Der Einzug entsteht dabei durch
   die VERSCHACHTELUNG (margin an .note-tree-children), nicht durch einen aus der Tiefe
   gerechneten Abstand. Das war vorher die Fehlerquelle: Die Ordnerzeilen rückten über
   padding PLUS Chevron und Icon ein, die eingebettete Notizliste nur über padding – ihre
   Notizen standen dadurch links von ihrem eigenen Ordner. Jetzt trägt jede Ebene denselben
   Versatz, und die Führungslinie sitzt automatisch an der richtigen Stelle.

   Der Aufklapp-Zustand wird als Menge der ZUGEklappten Schlüssel durchgereicht:
   leer = alles offen, was bei wenigen Notizen der freundlichere Startzustand ist.
   Gemerkt wird er bewusst nicht. *@
@foreach (var node in Nodes)
{
    var offen = !Collapsed.Contains(node.Key);

    <div class="note-tree-node" @key="node.Key">
        @* Aktionen liegen NEBEN dem Schalter, nicht darin: Ein Button im Button wäre
           ungültiges HTML und der Klick landete beim falschen Ziel. *@
        <div class="note-tree-row">
            <button type="button" class="note-tree-folder"
                    @onclick="() => Toggle(node.Key)"
                    title="@node.Label">
                <span class="note-tree-chevron" aria-hidden="true">@(offen ? "▾" : "▸")</span>
                <span class="note-tree-icon" aria-hidden="true">
                    <span class="note-tree-dot @(IsHollow(node.Kind) ? "is-hollow" : "")"
                          style="@DotStyle(node)"></span>
                </span>
                <span class="note-tree-label text-truncate">@node.Label</span>
                <span class="note-tree-count">@NoteTreeBuilder.CountNotes(node)</span>
            </button>
            @NodeActions?.Invoke(node)
        </div>

        @if (offen && (node.Notes.Count > 0 || node.Children.Count > 0))
        {
            <div class="note-tree-children">
                @* Notizen direkt in diesem Ordner (z. B. am Projekt statt am Task). Der
                   Zusatz-Einzug bringt ihre Titel auf die Höhe der Beschriftung eines
                   Unterordners – sie sind Geschwister von dessen Zeile, nicht davon. *@
                @if (node.Notes.Count > 0)
                {
                    <div class="note-tree-notes">
                        <NoteList Notes="node.Notes" SelectedId="SelectedId" OnSelect="OnSelect" Compact="true" />
                    </div>
                }

                @if (node.Children.Count > 0)
                {
                    <NoteTree Nodes="node.Children" Collapsed="Collapsed"
                              SelectedId="SelectedId" OnSelect="OnSelect" NodeActions="NodeActions" />
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public List<NoteTreeBuilder.Node> Nodes { get; set; } = new();

    // Zugeklappte Schlüssel – geteilt über alle Ebenen, damit der Zustand beim
    // Auf-/Zuklappen einer Ebene nicht die anderen zurücksetzt.
    [Parameter, EditorRequired] public HashSet<string> Collapsed { get; set; } = new();

    [Parameter] public int? SelectedId { get; set; }
    [Parameter] public EventCallback<NoteListItemDto> OnSelect { get; set; }

    // Optionale Aktionen je Ordnerzeile (Umbenennen, Löschen …). Der abgeleitete Baum
    // lässt sie weg – dort gibt es nichts zu bearbeiten.
    [Parameter] public RenderFragment<NoteTreeBuilder.Node>? NodeActions { get; set; }

    private void Toggle(string key)
    {
        if (!Collapsed.Remove(key)) Collapsed.Add(key);
    }

    // Arbeitsbereich und Projekt tragen ihre Farbe als gefüllten Punkt – dieselbe
    // Farbsprache wie Kalender und Projektkarten. Task und Ordner haben keine eigene
    // Farbe und bekommen einen hohlen Punkt; das unterscheidet sie auch in Graustufen.
    private static bool IsHollow(NoteTreeBuilder.NodeKind kind) =>
        kind is NoteTreeBuilder.NodeKind.Task or NoteTreeBuilder.NodeKind.Folder;

    private static string? DotStyle(NoteTreeBuilder.Node node) =>
        node.Color is string color ? $"background-color:{color};border-color:{color};" : null;
}
