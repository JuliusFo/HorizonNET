@inject JournalLockState Lock

@* Sperrbildschirm des Journals. Wird anstelle des Inhalts gezeigt, solange eine PIN
   eingerichtet und nicht eingegeben wurde. Der Inhalt wird dabei gar nicht erst
   gerendert – ein nur überdecktes Journal stünde im DOM und wäre auslesbar. *@
<div class="journal-lock">
    <div class="journal-lock-card">
        <div class="journal-lock-icon" aria-hidden="true">🔒</div>
        <h2 class="h5 mb-1">Journal gesperrt</h2>
        <p class="text-muted small mb-3">PIN eingeben, um fortzufahren.</p>

        <form @onsubmit="UnlockAsync" @onsubmit:preventDefault>
            <input @ref="input" type="password" inputmode="numeric" autocomplete="off"
                   class="form-control text-center journal-lock-input @(failed ? "is-invalid" : "")"
                   placeholder="••••" @bind="pin" @bind:event="oninput" />

            @if (failed)
            {
                <div class="invalid-feedback d-block">PIN stimmt nicht.</div>
            }

            <button type="submit" class="btn btn-primary w-100 mt-3" disabled="@(pin.Length == 0)">
                Entsperren
            </button>
        </form>

        @* Ehrlich bleiben: Die Sperre hält niemanden ab, der die API erreicht. *@
        <p class="journal-lock-hint text-muted mt-3 mb-0">
            Schützt vor fremden Blicken am offenen Rechner – nicht vor Zugriff auf die Daten selbst.
        </p>
    </div>
</div>

@code {
    private string pin = string.Empty;
    private bool failed;
    private ElementReference input;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Fokus direkt ins Feld: Sperre aufheben soll Tippen sein, nicht erst Klicken.
        if (firstRender) await input.FocusAsync();
    }

    private async Task UnlockAsync()
    {
        if (pin.Length == 0) return;

        if (await Lock.TryUnlockAsync(pin))
        {
            pin = string.Empty;
            failed = false;
            return;
        }

        failed = true;
        pin = string.Empty;
        await input.FocusAsync();
    }
}
