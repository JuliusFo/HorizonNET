@page "/projects/{Id:int}"
@inject ApiService Api
@inject ProjectState ProjectState
@inject IStringLocalizer<ProjectDetail> L
@inject IStringLocalizer<Enums> EnumL
@inject ToastService Toast
@inject SoundService Sound
@inject SettingsState Settings

<PageTitle>Projekt – HorizonNET</PageTitle>

@if (project is null)
{
    <p>@L["Loading"]</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start gap-2">
        <h1>@project.Name</h1>
        <button class="btn btn-sm btn-outline-primary btn-icon flex-shrink-0"
                @onclick="() => showProjectDialog = true" title="@L["Button_Edit_Title"]">✎</button>
    </div>

    <div class="mb-3">
        @if (project.Description is not null)
        {
            <p class="text-muted">@project.Description</p>
        }
        <span class="badge bg-secondary me-1">@EnumL[$"ProjectStatus_{project.Status}"]</span>
        <PriorityIndicator Value="@project.Priority" />
    </div>

    <h2>Tasks</h2>

    @if (tasks is null)
    {
        <p>@L["Loading"]</p>
    }
    else if (!tasks.Any())
    {
        <p>@L["NoTasks"]</p>
    }
    else
    {
        @* Sortiert wird beim Rendern, nicht in der Liste selbst – dadurch stimmt die
           Reihenfolge sofort nach jeder Änderung, ohne Neuladen. *@
        <ul class="list-group mb-4">
            @foreach (var task in OpenTasks(tasks))
            {
                @TaskBlock(task)
            }

            @* Erledigte Tasks stehen zugeklappt am Listenende – gleiche Konvention wie
               die Spalten "Fertig"/"Abgebrochen" im Kanban-Board. *@
            @if (DoneCount > 0)
            {
                <li class="list-group-item done-group">
                    <button type="button" class="done-group-toggle"
                            @onclick="() => doneCollapsed = !doneCollapsed">
                        <span class="done-group-caret">@(doneCollapsed ? "▸" : "▾")</span>
                        <span>@string.Format(L["Done_Group"], DoneCount)</span>
                    </button>
                </li>

                @if (!doneCollapsed)
                {
                    @foreach (var task in CompletedTasks(tasks))
                    {
                        @TaskBlock(task)
                    }
                }
            }
        </ul>
    }

    <!-- Formular zum Anlegen eines neuen Tasks -->
    <button class="btn btn-outline-primary mb-3" @onclick="ToggleForm">
        @(showForm ? L["NewTask_Cancel"] : L["NewTask_Button"])
    </button>

    @if (showForm)
    {
        <EditForm Model="newTask" OnValidSubmit="CreateTaskAsync" class="card p-3 mb-4">
            <DataAnnotationsValidator />

            @* Vorlage belegt Titel, Beschreibung und Priorität vor; das Projekt steht
               auf dieser Seite ohnehin fest und wird aus der Vorlage nicht übernommen. *@
            <div class="mb-3">
                <label class="form-label">@L["Field_Template"]</label>
                <TaskTemplatePicker OnSelected="ApplyTemplate" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["Field_Title"]</label>
                <InputText class="form-control" @bind-Value="newTask.Title" />
                <ValidationMessage For="() => newTask.Title" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["Field_Description"]</label>
                <InputTextArea class="form-control" rows="2" @bind-Value="newTask.Description" />
            </div>
            <div class="mb-3">
                <label class="form-label">@L["Field_DueDate"]</label>
                <InputDate class="form-control" @bind-Value="newTask.DueDate" />
            </div>
            <div class="row mb-3">
                <div class="col">
                    <label class="form-label">@L["Field_StartTime"]</label>
                    <InputDate class="form-control" Type="InputDateType.Time" @bind-Value="newTask.StartTime" />
                </div>
                <div class="col">
                    <label class="form-label">@L["Field_EndTime"]</label>
                    <InputDate class="form-control" Type="InputDateType.Time" @bind-Value="newTask.EndTime" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">@L["Field_Priority"]</label>
                <InputSelect class="form-select" @bind-Value="newTask.Priority">
                    @foreach (var priority in Enum.GetValues<Priority>())
                    {
                        <option value="@priority">@PriorityDisplay.Symbol(priority) @EnumL[$"Priority_{priority}"]</option>
                    }
                </InputSelect>
            </div>
            @if (errorMessage is not null)
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            <button type="submit" class="btn btn-primary" disabled="@isSaving">
                @(isSaving ? L["NewTask_Saving"] : L["NewTask_Save"])
            </button>
        </EditForm>
    }

    @* ── Notizen zum Projekt (Muster wie auf der Task-Detailseite) ───────────── *@
    <hr class="my-4" />

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0">Notizen</h2>
        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateNoteAsync">
            + Neue Notiz
        </button>
    </div>

    @if (notes is null)
    {
        <p class="text-muted small mb-0">@L["Loading"]</p>
    }
    else
    {
        @if (notes.Count > 0)
        {
            <div class="border rounded mb-3">
                <NoteList Notes="notes" SelectedId="selectedNote?.Id" OnSelect="SelectNoteAsync" />
            </div>
        }
        else if (selectedNote is null)
        {
            <p class="text-muted small">Noch keine Notizen zu diesem Projekt.</p>
        }

        @if (selectedNote is not null)
        {
            <div class="border rounded p-2 mb-4">
                <NoteEditor @ref="noteEditor" Note="selectedNote"
                            OnSaved="HandleNoteSaved" OnDeleted="HandleNoteDeleted" />
            </div>
        }
    }
}

<TaskEditDialog Visible="selectedTask is not null"
                Task="selectedTask"
                OnSaved="HandleTaskSaved"
                OnDeleted="HandleTaskDeleted"
                OnTaskUpdated="HandleTaskUpdated"
                OnClose="@(() => selectedTask = null)" />

<ProjectEditDialog Visible="showProjectDialog"
                   Project="project"
                   OnSaved="HandleProjectSavedAsync"
                   OnClose="@(() => showProjectDialog = false)" />

@code {
    [Parameter] public int Id { get; set; }

    private ProjectResponseDto? project;
    private List<TaskResponseDto>? tasks;
    private int? loadedId;

    // Notizen zum Projekt (Muster wie TaskDetail)
    private List<NoteListItemDto>? notes;
    private NoteResponseDto? selectedNote;
    private NoteEditor? noteEditor;

    // Projekt bearbeiten (geteilter Dialog)
    private bool showProjectDialog;

    // Neuer Task
    private TaskCreateFormModel newTask = new();
    private bool showForm;
    private bool isSaving;
    private string? errorMessage;

    // Bearbeiten-Dialog (geteilte Komponente)
    private TaskResponseDto? selectedTask;

    // Neuer Sub-Task
    private int? addingSubTaskForId;
    private TaskCreateFormModel newSubTask = new();
    private string? subTaskErrorMessage;
    private InputText? subTaskTitleInput;
    private bool focusSubTaskTitle;

    // OnParametersSetAsync statt OnInitializedAsync: lädt neu beim Wechsel
    // zwischen zwei Projekten (gleiche Komponenteninstanz, nur Id ändert sich).
    protected override async Task OnParametersSetAsync()
    {
        // Liefert den Startzustand der Sub-Task-Blöcke (SubTasksCollapsed).
        await Settings.EnsureLoadedAsync();

        if (loadedId == Id) return;

        // Der NoteEditor wird beim Projektwechsel nicht disposed (nur Note = null),
        // deshalb greift der Dispose-Flush nicht – offene Änderungen hier sichern.
        if (noteEditor is not null) await noteEditor.FlushAsync();

        loadedId = Id;

        // Beim Projektwechsel Daten und transienten UI-Zustand zurücksetzen.
        project            = null;
        tasks              = null;
        notes              = null;
        selectedNote       = null;
        selectedTask       = null;
        showForm           = false;
        addingSubTaskForId = null;
        subTasksToggled.Clear();
        subDoneExpanded.Clear();

        project = await Api.GetProjectAsync(Id);
        tasks   = await Api.GetTasksByProjectAsync(Id);
        notes   = await Api.GetNotesByProjectAsync(Id) ?? new();
    }

    // ── Reihenfolge ──────────────────────────────────────────────────────────

    // Haupt-Tasks: manuelle Reihenfolge (ListSortOrder). Erledigte Tasks bleiben als
    // Gruppe am Listenende – das ist die einzige verbliebene Automatik.
    private static IEnumerable<TaskResponseDto> OrderedTasks(IEnumerable<TaskResponseDto> source) =>
        source.OrderBy(t => t.IsCompleted).ThenBy(t => t.ListSortOrder);

    // Die beiden Gruppen der Liste: offen oben, erledigt in der Klapp-Gruppe darunter.
    private static IEnumerable<TaskResponseDto> OpenTasks(IEnumerable<TaskResponseDto> source) =>
        source.Where(t => !t.IsCompleted).OrderBy(t => t.ListSortOrder);

    private static IEnumerable<TaskResponseDto> CompletedTasks(IEnumerable<TaskResponseDto> source) =>
        source.Where(t => t.IsCompleted).OrderBy(t => t.ListSortOrder);

    // Erledigte Tasks starten zugeklappt; der Zustand gilt bis zum Neuladen und
    // übersteht – wie im Kanban-Board – einen Projektwechsel.
    private bool doneCollapsed = true;

    private int DoneCount => tasks?.Count(t => t.IsCompleted) ?? 0;

    // Sub-Tasks: rein manuell über SortOrder – dieselbe Reihenfolge wie in der SubTaskList
    // (Detailseite/Edit-Dialog), nur zusätzlich in "offen" und "erledigt" geteilt.
    private static IEnumerable<TaskResponseDto> OrderedSubTasks(TaskResponseDto parent) =>
        (parent.SubTasks ?? []).OrderBy(s => s.SortOrder);

    private static IEnumerable<TaskResponseDto> OpenSubTasks(TaskResponseDto parent) =>
        OrderedSubTasks(parent).Where(s => !s.IsCompleted);

    private static IEnumerable<TaskResponseDto> DoneSubTasks(TaskResponseDto parent) =>
        OrderedSubTasks(parent).Where(s => s.IsCompleted);

    private static int DoneSubCount(TaskResponseDto parent) =>
        parent.SubTasks?.Count(s => s.IsCompleted) ?? 0;

    // ── Sub-Tasks ein-/ausklappen ────────────────────────────────────────────
    // Zwei ineinander liegende Klapp-Ebenen, beide nur Seitenzustand:
    //   1. der ganze Sub-Task-Block eines Tasks (Startwert aus den Einstellungen),
    //   2. darin die erledigten Sub-Tasks – wie die Erledigt-Gruppe der Haupt-Tasks.
    //
    // Gemerkt wird nicht der Zustand, sondern die ABWEICHUNG vom Standard. Sonst müsste
    // beim Umstellen der Einstellung jeder bereits angefasste Task nachgezogen werden.
    private readonly HashSet<int> subTasksToggled = new();
    private readonly HashSet<int> subDoneExpanded = new();

    private bool SubTasksCollapsed(int taskId) =>
        Settings.SubTasksCollapsed ^ subTasksToggled.Contains(taskId);

    private void ToggleSubTasks(int taskId)
    {
        if (!subTasksToggled.Remove(taskId)) subTasksToggled.Add(taskId);
    }

    private void ToggleSubDone(int taskId)
    {
        if (!subDoneExpanded.Remove(taskId)) subDoneExpanded.Add(taskId);
    }

    // ── Sortieren per Drag & Drop ────────────────────────────────────────────

    private TaskResponseDto? draggedTask;
    private int? dragOverTaskId;

    private void ResetDrag()
    {
        draggedTask    = null;
        dragOverTaskId = null;
    }

    // Haupt-Task vor den Ziel-Task einsortieren (schreibt ListSortOrder).
    private async Task DropTaskAsync(TaskResponseDto target)
    {
        var dragged = draggedTask;
        ResetDrag();

        if (tasks is null || dragged is null || dragged.Id == target.Id) return;

        // Nur innerhalb der Haupt-Task-Ebene; ein Sub-Task hat hier nichts verloren.
        if (dragged.ParentTaskId is not null || target.ParentTaskId is not null) return;

        var ordered = OrderedTasks(tasks).ToList();
        ordered.RemoveAll(t => t.Id == dragged.Id);
        var idx = ordered.FindIndex(t => t.Id == target.Id);
        if (idx < 0) idx = ordered.Count;
        ordered.Insert(idx, dragged);

        // ListSortOrder lokal mitziehen, sonst rendert die Liste nach den alten Werten.
        for (var i = 0; i < ordered.Count; i++)
            ordered[i] = ordered[i] with { ListSortOrder = i };

        // GetTasksByProjectAsync liefert ausschließlich Haupt-Tasks – die Liste darf
        // deshalb komplett ersetzt werden.
        tasks = ordered;

        await Api.ReorderTaskListAsync(ordered.Select(t => t.Id).ToList());
    }

    // Sub-Task vor den Ziel-Sub-Task einsortieren (schreibt SortOrder, wie die SubTaskList).
    private async Task DropSubTaskAsync(TaskResponseDto parent, TaskResponseDto target)
    {
        var dragged = draggedTask;
        ResetDrag();

        if (tasks is null || dragged is null || dragged.Id == target.Id) return;

        // Nur Geschwister desselben Eltern-Tasks tauschen die Plätze.
        if (dragged.ParentTaskId != parent.Id || target.ParentTaskId != parent.Id) return;

        var ordered = OrderedSubTasks(parent).ToList();
        ordered.RemoveAll(s => s.Id == dragged.Id);
        var idx = ordered.FindIndex(s => s.Id == target.Id);
        if (idx < 0) idx = ordered.Count;
        ordered.Insert(idx, dragged);

        for (var i = 0; i < ordered.Count; i++)
            ordered[i] = ordered[i] with { SortOrder = i };

        var parentIdx = tasks.FindIndex(t => t.Id == parent.Id);
        if (parentIdx >= 0) tasks[parentIdx] = parent with { SubTasks = ordered };

        await Api.ReorderSubTasksAsync(ordered.Select(s => s.Id).ToList());
    }

    // ── Render-Helfer ────────────────────────────────────────────────────────

    // Ein Haupt-Task mit seinen Sub-Tasks und dem Anlege-Formular. Als Fragment, weil
    // der Block an zwei Stellen gerendert wird: oben die offenen, unten (aufgeklappt)
    // die erledigten.
    private RenderFragment TaskBlock(TaskResponseDto task) => __builder =>
    {
        @* @key ist hier zwingend: Abhaken und Umsortieren ordnen die Liste um. Ohne
           Schlüssel verwendet Blazor die <li> positionsweise wieder – das Status-
           Dropdown des nachrückenden Tasks behielte dann die vom Nutzer gewählte
           Auswahl (z. B. "Fertig"), weil sich sein value-Attribut nicht ändert. *@
        <li @key="task.Id"
            class="list-group-item maintask-item @(task.IsCompleted ? "task-completed" : "") @(dragOverTaskId == task.Id ? "task-drop-before" : "")"
            draggable="true"
            @ondragstart="() => draggedTask = task"
            @ondragend="ResetDrag"
            @ondragover:preventDefault="true"
            @ondragover="() => { if (draggedTask is { ParentTaskId: null }) dragOverTaskId = task.Id; }"
            @ondrop="() => DropTaskAsync(task)">
            @TaskRow(task, isSubTask: false)
        </li>

        @* Sub-Tasks eingerückt darunter – offene zuerst, erledigte in einer eigenen
           Klapp-Gruppe. Der ganze Block hängt am Pfeil in der Eltern-Zeile. *@
        @if (task.SubTasks is { Count: > 0 } && !SubTasksCollapsed(task.Id))
        {
            @foreach (var sub in OpenSubTasks(task))
            {
                @SubTaskRow(task, sub, sortable: true)
            }

            @if (DoneSubCount(task) > 0)
            {
                <li class="list-group-item subtask-item subtask-done-group">
                    <button type="button" class="done-group-toggle"
                            @onclick="() => ToggleSubDone(task.Id)"
                            title="@(subDoneExpanded.Contains(task.Id) ? "Erledigte Sub-Tasks ausblenden" : "Erledigte Sub-Tasks einblenden")">
                        <span class="done-group-caret">@(subDoneExpanded.Contains(task.Id) ? "▾" : "▸")</span>
                        <span>@string.Format(L["Done_Group"], DoneSubCount(task))</span>
                    </button>
                </li>

                @if (subDoneExpanded.Contains(task.Id))
                {
                    @foreach (var sub in DoneSubTasks(task))
                    {
                        @SubTaskRow(task, sub, sortable: false)
                    }
                }
            }
        }

        @* Sub-Task-Erstellformular *@
        @if (addingSubTaskForId == task.Id)
        {
            <li class="list-group-item ps-5 subtask-item">
                <EditForm Model="newSubTask" OnValidSubmit="() => CreateSubTaskAsync(task.Id)" class="row g-2">
                    <DataAnnotationsValidator />
                    <div class="col-12">
                        <InputText @ref="subTaskTitleInput" class="form-control form-control-sm"
                                   @bind-Value="newSubTask.Title" placeholder="@L["SubTask_Placeholder"]" />
                        <ValidationMessage For="() => newSubTask.Title" />
                    </div>
                    <div class="col-md-6">
                        <InputDate class="form-control form-control-sm" @bind-Value="newSubTask.DueDate" />
                    </div>
                    <div class="col-md-6">
                        <InputSelect class="form-select form-select-sm" @bind-Value="newSubTask.Priority">
                            @foreach (var p in Enum.GetValues<Priority>())
                            {
                                <option value="@p">@PriorityDisplay.Symbol(p) @EnumL[$"Priority_{p}"]</option>
                            }
                        </InputSelect>
                    </div>
                    @if (subTaskErrorMessage is not null)
                    {
                        <div class="col-12"><div class="alert alert-danger py-1">@subTaskErrorMessage</div></div>
                    }
                    <div class="col-12 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary" disabled="@isSaving">@L["Task_EditSave"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelSubTask">@L["Task_EditCancel"]</button>
                    </div>
                </EditForm>
            </li>
        }
    };

    // Eine Sub-Task-Zeile. Erledigte sind bewusst NICHT sortierbar: In der Erledigt-Gruppe
    // spielt die Reihenfolge keine Rolle, und ein Drop dorthin setzte einen offenen Sub-Task
    // an eine Stelle, die man in der geteilten Liste gar nicht sieht.
    private RenderFragment SubTaskRow(TaskResponseDto parent, TaskResponseDto sub, bool sortable) => __builder =>
    {
        @* draggable als Zeichenkette, nicht als bool: Ein false-bool ließe Blazor das
           Attribut ganz weg – draggable wertet das als "auto" statt als "nein". *@
        <li @key="sub.Id"
            class="list-group-item ps-5 @(sub.IsCompleted ? "task-completed" : "") subtask-item @(dragOverTaskId == sub.Id ? "task-drop-before" : "")"
            draggable="@(sortable ? "true" : "false")"
            @ondragstart="() => { if (sortable) draggedTask = sub; }"
            @ondragend="ResetDrag"
            @ondragover:preventDefault="true"
            @ondragover="() => { if (sortable && draggedTask?.ParentTaskId == sub.ParentTaskId) dragOverTaskId = sub.Id; }"
            @ondrop="() => sortable ? DropSubTaskAsync(parent, sub) : Task.CompletedTask">
            @TaskRow(sub, isSubTask: true, sortable: sortable)
        </li>
    };

    private RenderFragment TaskRow(TaskResponseDto task, bool isSubTask, bool sortable = true) => __builder =>
    {
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                @* Pfeil zum Ein-/Ausklappen der Sub-Tasks. Tasks ohne Sub-Tasks bekommen
                   einen Platzhalter, damit die Spalten der Liste in einer Flucht bleiben. *@
                @if (!isSubTask)
                {
                    @if (task.SubTasks is { Count: > 0 })
                    {
                        <button type="button" class="subtask-caret"
                                @onclick="() => ToggleSubTasks(task.Id)"
                                title="@(SubTasksCollapsed(task.Id) ? "Sub-Tasks einblenden" : "Sub-Tasks ausblenden")">
                            @(SubTasksCollapsed(task.Id) ? "▸" : "▾")
                        </button>
                    }
                    else
                    {
                        <span class="subtask-caret-empty"></span>
                    }
                }

                @if (sortable)
                {
                    <span class="task-handle" title="Zum Sortieren ziehen">⠿</span>
                }
                else
                {
                    <span class="task-handle-empty"></span>
                }

                @* Schnell-Abschluss: Haken setzt auf "Fertig", Abwählen zurück auf "Geplant". *@
                <input type="checkbox" class="form-check-input task-done-check flex-shrink-0"
                       checked="@task.IsCompleted"
                       @onchange="async e => await ToggleDoneAsync(task, (bool)e.Value!)"
                       title="@(task.IsCompleted ? L["Task_Undone_Title"] : L["Task_Done_Title"])" />

                <select class="form-select form-select-sm w-auto"
                        value="@task.Status"
                        @onchange="async e => await ChangeStatusAsync(task, Enum.Parse<WorkStatus>(e.Value!.ToString()!))">
                    @foreach (var s in Enum.GetValues<WorkStatus>())
                    {
                        <option value="@s">@EnumL[$"WorkStatus_{s}"]</option>
                    }
                </select>
                <div>
                    <a href="@($"tasks/{task.Id}")" class="task-title-link" title="@L["Button_Edit_Title"]">
                        <strong class="@(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                            @task.Title
                        </strong>
                    </a>
                    @* Zugeklappt bleibt der Fortschritt sichtbar – sonst wäre nicht zu
                       erkennen, ob unter dem Task noch etwas offen ist. *@
                    @if (!isSubTask && task.SubTasks is { Count: > 0 } && SubTasksCollapsed(task.Id))
                    {
                        <span class="subtask-summary" title="Erledigte Sub-Tasks">
                            @DoneSubCount(task)/@task.SubTasks.Count
                        </span>
                    }
                    @if (task.Description is not null)
                    {
                        <span class="text-muted ms-2">@task.Description</span>
                    }
                    @if (task.DueDate is not null)
                    {
                        <div class="small text-muted">
                            @string.Format(L["Task_DueDate"], task.DueDate.Value.ToString("dd.MM.yyyy"))
                            @if (task.StartTime is not null && task.EndTime is not null)
                            {
                                <span> · @task.StartTime.Value.ToString("HH:mm") – @task.EndTime.Value.ToString("HH:mm")</span>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                @* Erledigte Tasks brauchen keinen Start-Knopf mehr. *@
                @if (!task.IsCompleted)
                {
                    <TaskTimerButton Task="task" OnChanged="HandleTimerChanged" />
                }
                <PriorityIndicator Value="@task.Priority" />
                @if (!isSubTask)
                {
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="() => StartAddSubTask(task.Id)"
                            title="@L["Button_AddSubTask_Title"]">＋</button>
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenEdit(task)" title="@L["Button_Edit_Title"]">✎</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTaskAsync(task)" title="@L["Button_Delete_Title"]">🗑</button>
            </div>
        </div>
    };

    // Ein Start stoppt ggf. den Timer eines anderen Tasks dieser Liste und ändert
    // dessen Status mit – deshalb die ganze Liste neu laden statt nur den einen Task.
    private async Task HandleTimerChanged(TaskResponseDto _) =>
        tasks = await Api.GetTasksByProjectAsync(Id);

    // ── Abschließen / Zurücksetzen ───────────────────────────────────────────

    // Schnell-Abschluss über die Checkbox: an → "Fertig", aus → zurück auf "Geplant"
    // (bewusst kein Merken des vorherigen Status – konsistent zur Heute-Seite und SubTaskList).
    private async Task ToggleDoneAsync(TaskResponseDto task, bool done)
    {
        var target = done ? WorkStatus.Done : WorkStatus.Planned;
        if (task.Status == target) return;

        if (!await ChangeStatusAsync(task, target))
        {
            await Sound.ErrorAsync();
            return;
        }

        if (done) await Sound.SuccessAsync();
    }

    private async Task<bool> ChangeStatusAsync(TaskResponseDto task, WorkStatus newStatus)
    {
        var updated = await Api.SetTaskStatusAsync(task.Id, newStatus);
        if (updated is null) return false;

        ReplaceTask(updated);
        SyncProjectCounts();
        return true;
    }

    // ── Zugriff auf die Liste ────────────────────────────────────────────────
    // Ein Task steht entweder oben in der Liste oder als Sub-Task unter seinem Eltern-Task.
    // Diese Unterscheidung stand vorher an fünf Stellen ausgeschrieben – jedes Mal etwas
    // anders formuliert, obwohl immer dasselbe gemeint war. Ab hier steht sie einmal hier,
    // und die Aufrufer sagen nur noch, WAS passieren soll.
    //
    // Alle drei arbeiten auf der geladenen Liste, nicht auf dem Server: Der Aufrufer hat
    // die Antwort der API bereits in der Hand und spart sich damit ein Neuladen.

    private TaskResponseDto? FindTask(int id) =>
        tasks?.FirstOrDefault(t => t.Id == id)
        ?? tasks?.SelectMany(t => t.SubTasks ?? []).FirstOrDefault(s => s.Id == id);

    // Ersetzt den Task durch seinen frischen Stand. Ist er nicht (mehr) in der Liste,
    // passiert nichts – das ist kein Fehler, sondern der Normalfall nach einem Wechsel.
    private void ReplaceTask(TaskResponseDto updated)
    {
        if (tasks is null) return;

        var idx = tasks.FindIndex(t => t.Id == updated.Id);
        if (idx >= 0)
        {
            tasks[idx] = updated;
            return;
        }

        var subTasks = tasks.FirstOrDefault(t => t.SubTasks?.Any(s => s.Id == updated.Id) == true)?.SubTasks;
        var subIdx = subTasks?.FindIndex(s => s.Id == updated.Id) ?? -1;
        if (subIdx >= 0) subTasks![subIdx] = updated;
    }

    private void RemoveTask(int id)
    {
        if (tasks is null) return;

        if (tasks.RemoveAll(t => t.Id == id) > 0) return;

        tasks.FirstOrDefault(t => t.SubTasks?.Any(s => s.Id == id) == true)
             ?.SubTasks?.RemoveAll(s => s.Id == id);
    }

    // ── Bearbeiten (geteilter Dialog) ─────────────────────────────────────────

    private void OpenEdit(TaskResponseDto task) => selectedTask = task;

    private void HandleTaskSaved(TaskResponseDto updated)
    {
        ReplaceTask(updated);
        SyncProjectCounts();
        selectedTask = null;
    }

    private void HandleTaskDeleted(int id)
    {
        // Titel VOR dem Entfernen holen – danach ist er nicht mehr zu haben.
        var title = FindTask(id)?.Title;

        RemoveTask(id);
        SyncProjectCounts();
        selectedTask = null;
        ShowTaskUndo(id, title);
    }

    // Live-Aktualisierung (Sub-Tasks geändert) – Dialog bleibt offen, die
    // Sub-Task-Zeilen in der Liste aktualisieren sich mit.
    private void HandleTaskUpdated(TaskResponseDto updated)
    {
        ReplaceTask(updated);
        SyncProjectCounts();
    }

    // ── Löschen ──────────────────────────────────────────────────────────────

    // Kein isSubTask-Kennzeichen mehr: RemoveTask findet den Task selbst. Das Kennzeichen
    // musste vorher an jeder Aufrufstelle richtig gesetzt werden – eine Fehlerquelle, die
    // nichts zur Sache beitrug.
    private async Task DeleteTaskAsync(TaskResponseDto task)
    {
        if (!await Api.DeleteTaskAsync(task.Id)) return;

        RemoveTask(task.Id);
        SyncProjectCounts();
        ShowTaskUndo(task.Id, task.Title);
    }

    private void ShowTaskUndo(int id, string? title)
    {
        Toast.ShowUndo(string.IsNullOrWhiteSpace(title) ? "Task gelöscht" : $"{title} gelöscht", async () =>
        {
            if (!await Api.RestoreTaskAsync(id)) return;
            tasks = await Api.GetTasksByProjectAsync(Id);
            SyncProjectCounts();
            await InvokeAsync(StateHasChanged);
        });
    }

    // ── Sub-Task anlegen ─────────────────────────────────────────────────────

    private void StartAddSubTask(int parentId)
    {
        addingSubTaskForId  = parentId;
        subTaskErrorMessage = null;
        newSubTask          = new();

        // Zugeklappt bliebe das Formular unsichtbar – wer einen Sub-Task anlegt, will den
        // Block sehen. Der Task gilt danach als vom Nutzer aufgeklappt.
        if (SubTasksCollapsed(parentId)) ToggleSubTasks(parentId);
    }

    private void CancelSubTask()
    {
        addingSubTaskForId  = null;
        subTaskErrorMessage = null;
    }

    private async Task CreateSubTaskAsync(int parentId)
    {
        isSaving            = true;
        subTaskErrorMessage = null;

        var dto = new TaskCreateDto(
            newSubTask.Title,
            string.IsNullOrWhiteSpace(newSubTask.Description) ? null : newSubTask.Description,
            newSubTask.DueDate, null, null,
            newSubTask.Priority, Id,
            ParentTaskId: parentId);

        var created = await Api.CreateTaskAsync(dto);
        if (created is not null && tasks is not null)
        {
            var parentTask = tasks.FirstOrDefault(t => t.Id == parentId);
            if (parentTask is not null)
            {
                var updatedSubTasks = (parentTask.SubTasks ?? []).Append(created).ToList();
                tasks[tasks.IndexOf(parentTask)] = parentTask with { SubTasks = updatedSubTasks };
                SyncProjectCounts();
            }

            // Formular bleibt offen: Titel → Enter → Titel → Enter. Geschlossen wird
            // nur über "Abbrechen" (CancelSubTask) oder beim Projektwechsel.
            newSubTask        = new();
            focusSubTaskTitle = true;
        }
        else
        {
            subTaskErrorMessage = L["SubTask_Error"];
        }

        isSaving = false;
    }

    // Fokus erst nach dem Render setzen: die neue Sub-Task-Zeile verschiebt das
    // Formular im DOM, vorher zeigt die ElementReference noch auf das alte Feld.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusSubTaskTitle) return;
        focusSubTaskTitle = false;

        if (subTaskTitleInput?.Element is ElementReference el)
            await el.FocusAsync();
    }

    // ── Erstellen ────────────────────────────────────────────────────────────

    private void ToggleForm()
    {
        showForm     = !showForm;
        errorMessage = null;
        newTask      = new();
    }

    // Vorlage ins Formular übernehmen. Bereits Getipptes wird bewusst überschrieben –
    // die Auswahl ist eine explizite Aktion des Nutzers.
    private void ApplyTemplate(TaskTemplateResponseDto template)
    {
        newTask.Title       = template.Title;
        newTask.Description = template.Description;
        newTask.Priority    = Enum.Parse<Priority>(template.Priority);
    }

    private async Task CreateTaskAsync()
    {
        isSaving     = true;
        errorMessage = null;

        var dto = new TaskCreateDto(
            newTask.Title,
            string.IsNullOrWhiteSpace(newTask.Description) ? null : newTask.Description,
            newTask.DueDate, newTask.StartTime, newTask.EndTime,
            newTask.Priority, Id);

        var created = await Api.CreateTaskAsync(dto);
        if (created is not null)
        {
            tasks ??= [];
            tasks.Add(created);
            showForm = false;
            newTask  = new();
            SyncProjectCounts();
        }
        else
        {
            errorMessage = L["NewTask_Error"];
        }

        isSaving = false;
    }

    // ── Notizen ──────────────────────────────────────────────────────────────

    private async Task CreateNoteAsync()
    {
        if (noteEditor is not null) await noteEditor.FlushAsync();

        var created = await Api.CreateNoteAsync(new NoteCreateDto("Neue Notiz", null, ProjectId: Id));
        if (created is null || notes is null) return;

        notes.Insert(0, NoteListItemDto.From(created));
        selectedNote = created;
    }

    private async Task SelectNoteAsync(NoteListItemDto note)
    {
        if (selectedNote?.Id == note.Id) return;
        if (noteEditor is not null) await noteEditor.FlushAsync(); // offene Änderungen sichern
        selectedNote = await Api.GetNoteAsync(note.Id);            // volle Notiz inkl. Content laden
    }

    private void HandleNoteSaved(NoteResponseDto updated)
    {
        if (notes is null) return;

        var idx = notes.FindIndex(n => n.Id == updated.Id);
        if (idx >= 0) notes[idx] = NoteListItemDto.From(updated);
        if (selectedNote?.Id == updated.Id) selectedNote = updated;

        StateHasChanged();
    }

    private void HandleNoteDeleted(int id)
    {
        var title = notes?.FirstOrDefault(n => n.Id == id)?.Title;
        notes?.RemoveAll(n => n.Id == id);
        if (selectedNote?.Id == id) selectedNote = null;

        Toast.ShowUndo(string.IsNullOrWhiteSpace(title) ? "Notiz gelöscht" : $"{title} gelöscht", async () =>
        {
            if (!await Api.RestoreNoteAsync(id)) return;
            notes = await Api.GetNotesByProjectAsync(Id) ?? notes;
            await InvokeAsync(StateHasChanged);
        });
    }

    // ── Projekt bearbeiten (ProjectEditDialog) ───────────────────────────────

    private void HandleProjectSavedAsync(ProjectResponseDto saved)
    {
        project           = saved;
        showProjectDialog = false;

        // Geteilten State mitziehen, damit Navigation/Übersicht nicht veralten.
        var all = ProjectState.Projects;
        if (all is not null)
        {
            var idx = all.FindIndex(p => p.Id == saved.Id);
            if (idx >= 0) all[idx] = saved;
            ProjectState.NotifyChanged();
        }
    }

    // Hält die gecachten Projekt-Zähler (Anzahl/Fortschritt auf den Karten in Übersicht
    // und Arbeitsbereich) synchron, nachdem sich hier Tasks geändert haben – sonst zeigen
    // die Karten veraltete Werte, bis die Projekte neu geladen werden. Formel exakt wie
    // serverseitig in ProjectsController.ToDto: alle nicht gelöschten Tasks des Projekts
    // (Haupt- UND Sub-Tasks) bzw. die davon erledigten. Kein API-Aufruf nötig, weil die
    // vollständige Liste hier ohnehin vorliegt.
    private void SyncProjectCounts()
    {
        if (tasks is null) return;

        var total = tasks.Count + tasks.Sum(t => t.SubTasks?.Count ?? 0);
        var done  = tasks.Count(t => t.IsCompleted)
                  + tasks.Sum(t => t.SubTasks?.Count(s => s.IsCompleted) ?? 0);

        var cached = ProjectState.Projects;
        var idx    = cached?.FindIndex(p => p.Id == Id) ?? -1;
        if (cached is null || idx < 0) return;
        if (cached[idx].TaskCount == total && cached[idx].DoneTaskCount == done) return;

        cached[idx] = cached[idx] with { TaskCount = total, DoneTaskCount = done };
        ProjectState.NotifyChanged();
    }

    // ── Formularmodelle ──────────────────────────────────────────────────────

    private class TaskCreateFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Titel ist erforderlich.")]
        [System.ComponentModel.DataAnnotations.MaxLength(300)]
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DateTime? DueDate { get; set; }
        public DateTime? StartTime { get; set; }
        public DateTime? EndTime { get; set; }
        public Priority Priority { get; set; } = Priority.Medium;
    }

}
