@page "/settings"
@inject SettingsState AppSettings
@inject ApiService Api
@inject HttpClient Http
@inject VersionState Version
@inject JournalLockState JournalLock
@inject ToastService Toast
@inject ConfirmService Confirm
@inject AuthState Auth

<PageTitle>Einstellungen – HorizonNET</PageTitle>

<h1 class="mb-4">Einstellungen</h1>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Allgemein</div>
    <div class="card-body">
        <label for="calView" class="form-label">Standard-Ansicht im Kalender</label>
        <select id="calView" class="form-select" style="max-width: 16rem;"
                value="@AppSettings.CalendarDefaultView"
                @onchange="OnCalendarViewChanged">
            <option value="0">Tag</option>
            <option value="1">Woche</option>
            <option value="2">Monat</option>
        </select>
        <div class="form-text">Wird beim Öffnen des Kalenders vorausgewählt.</div>

        <div class="form-check form-switch mt-3">
            <input class="form-check-input" type="checkbox" id="soundsToggle"
                   checked="@AppSettings.SoundsEnabled" @onchange="OnSoundsChanged" />
            <label class="form-check-label" for="soundsToggle">Sound-Effekte</label>
        </div>
        <div class="form-text">Kurze Töne bei erledigten Tasks und Daily Tasks.</div>

        <div class="form-check form-switch mt-3">
            <input class="form-check-input" type="checkbox" id="subTasksToggle"
                   checked="@AppSettings.SubTasksCollapsed" @onchange="OnSubTasksCollapsedChanged" />
            <label class="form-check-label" for="subTasksToggle">Sub-Tasks eingeklappt starten</label>
        </div>
        <div class="form-text">
            Zeigt bei Tasks mit Sub-Tasks zunächst nur den Fortschritt (z. B. 2/5).
            Je Task lässt sich das mit dem Pfeil vor dem Titel umschalten.
        </div>
    </div>
</div>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Konto</div>
    <div class="card-body">
        <p class="text-muted">
            Angemeldet als <strong>@Auth.Username</strong>. Das Passwort gilt für die
            gesamte App – die laufende Sitzung bleibt nach der Änderung angemeldet.
        </p>

        <div style="max-width: 22rem;">
            <label for="pwCurrent" class="form-label">Aktuelles Passwort</label>
            <input id="pwCurrent" type="password" class="form-control" autocomplete="current-password"
                   @bind="currentPassword" @bind:event="oninput" disabled="@passwordBusy" />

            <label for="pwNew" class="form-label mt-3">Neues Passwort</label>
            <input id="pwNew" type="password" class="form-control" autocomplete="new-password"
                   @bind="newPassword" @bind:event="oninput" disabled="@passwordBusy" />

            <label for="pwRepeat" class="form-label mt-3">Neues Passwort wiederholen</label>
            <input id="pwRepeat" type="password" class="form-control" autocomplete="new-password"
                   @bind="newPasswordRepeat" @bind:event="oninput" disabled="@passwordBusy" />

            @if (RepeatMismatch)
            {
                <div class="form-text text-danger">Die Wiederholung stimmt nicht überein.</div>
            }

            @if (passwordError is not null)
            {
                <div class="alert alert-danger py-2 mt-3 mb-0" role="alert">@passwordError</div>
            }

            <button type="button" class="btn btn-primary mt-3" @onclick="ChangePasswordAsync"
                    disabled="@(!CanChangePassword)">
                @(passwordBusy ? "Ändern…" : "Passwort ändern")
            </button>
        </div>
    </div>
</div>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Journal-Sperre</div>
    <div class="card-body">
        <p class="text-muted">
            Sichert das Journal mit einer PIN, die nach einer Zeit ohne Eingabe erneut
            abgefragt wird. Das schützt vor fremden Blicken am offenen Rechner –
            <strong>nicht</strong> vor Zugriff auf die Daten selbst: Wer die API erreicht,
            liest das Journal auch ohne PIN.
        </p>

        @if (JournalLock.IsConfigured)
        {
            <div class="mb-3"><span class="badge bg-success">PIN eingerichtet</span></div>
        }

        <div class="row g-2 align-items-end mb-3" style="max-width: 30rem;">
            <div class="col-sm">
                <label for="journalPin" class="form-label">@(JournalLock.IsConfigured ? "Neue PIN" : "PIN festlegen")</label>
                <input id="journalPin" type="password" inputmode="numeric" autocomplete="new-password"
                       class="form-control" placeholder="mindestens 4 Zeichen" @bind="newPin" />
            </div>
            <div class="col-sm-auto">
                <button class="btn btn-primary" @onclick="SavePinAsync"
                        disabled="@(newPin.Trim().Length < 4)">Speichern</button>
            </div>
            @if (JournalLock.IsConfigured)
            {
                <div class="col-sm-auto">
                    <button class="btn btn-outline-danger" @onclick="RemovePinAsync">PIN entfernen</button>
                </div>
            }
        </div>

        <label for="journalTimeout" class="form-label">Automatisch sperren nach</label>
        <select id="journalTimeout" class="form-select" style="max-width: 16rem;"
                value="@JournalLock.TimeoutMinutes" @onchange="OnTimeoutChanged">
            <option value="1">1 Minute</option>
            <option value="5">5 Minuten</option>
            <option value="15">15 Minuten</option>
            <option value="60">1 Stunde</option>
            <option value="0">Nie</option>
        </select>
        <div class="form-text">
            Gezählt wird ab der letzten Eingabe oder Mausbewegung. Nach dem Neuladen der
            Seite ist das Journal ohnehin wieder gesperrt.
        </div>
    </div>
</div>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Journal-Vorlagen</div>
    <div class="card-body">
        <p class="text-muted">
            Leitfragen für Journal-Einträge. Sie erscheinen als Leiste über dem Text und
            setzen ihre Fragen per Klick ein – gegen das leere Blatt.
        </p>
        <JournalTemplateManager />
    </div>
</div>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Task-Vorlagen</div>
    <div class="card-body">
        <p class="text-muted">
            Vorlagen für wiederkehrende Aufgaben. Beim Anlegen eines Tasks lassen sie sich
            auswählen und belegen Titel, Beschreibung, Priorität und Projekt vor.
        </p>
        <TaskTemplateManager />
    </div>
</div>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Kalender-Synchronisation</div>
    <div class="card-body">
        <p class="text-muted">
            Verbinde deinen Google- <strong>oder</strong> Nextcloud-Kalender, um dessen Termine hier
            anzuzeigen und geplante Tasks dorthin zu schreiben. Es ist immer nur ein Kalender verbunden.
        </p>

        @if (GoogleResult == "connected")
        {
            <div class="alert alert-success py-2">Google-Konto erfolgreich verbunden.</div>
        }
        else if (GoogleResult == "noscope")
        {
            <div class="alert alert-warning py-2">
                Der <strong>Kalenderzugriff</strong> wurde nicht erteilt. Bitte erneut verbinden und
                auf dem Google-Zustimmungsbildschirm die <strong>Kalender-Berechtigung</strong> ankreuzen.
            </div>
        }
        else if (GoogleResult == "error")
        {
            <div class="alert alert-danger py-2">Verbindung fehlgeschlagen. Bitte erneut versuchen.</div>
        }

        @if (status is null)
        {
            <p class="text-muted mb-0">Status wird geladen…</p>
        }
        else
        {
            @if (status.Connected)
            {
                <div class="mb-3">
                    <span class="badge bg-success">Verbunden mit @ProviderLabel(status.Provider)</span>
                    @if (!string.IsNullOrEmpty(status.Account))
                    {
                        <span class="ms-2">@status.Account</span>
                    }
                    @if (!string.IsNullOrEmpty(status.CalendarName))
                    {
                        <span class="text-muted ms-1">· Kalender „@status.CalendarName“</span>
                    }
                </div>
                <label for="calendarReminder" class="form-label">Erinnerung am gespiegelten Termin</label>
                <select id="calendarReminder" class="form-select" style="max-width: 16rem;"
                        value="@(reminderMinutes?.ToString() ?? "")"
                        @onchange="OnReminderChanged">
                    <option value="">Keine Erinnerung</option>
                    <option value="0">Zum Termin</option>
                    <option value="10">10 Minuten vorher</option>
                    <option value="15">15 Minuten vorher</option>
                    <option value="30">30 Minuten vorher</option>
                    <option value="60">1 Stunde vorher</option>
                    <option value="1440">1 Tag vorher</option>
                </select>
                <div class="form-text mb-3">
                    Gilt für Tasks, die in deinen Kalender geschrieben werden.
                    <strong>Erledigte Tasks erinnern nie</strong> – ihr Termin bleibt sichtbar, wird mit „✓"
                    gekennzeichnet und zählt als „frei". Änderungen wirken beim nächsten Speichern
                    eines Tasks; bestehende Termine bleiben bis dahin, wie sie sind.
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-danger" @onclick="DisconnectAsync" disabled="@busy">
                        Verbindung trennen
                    </button>
                    @if (!switching && OtherProviderAvailable)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="StartSwitch" disabled="@busy">
                            Zu @ProviderLabel(OtherProvider) wechseln…
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="mb-3">
                    <span class="badge bg-secondary">Nicht verbunden</span>
                </div>
            }

            @if (!status.Connected || switching)
            {
                <div class="@(status.Connected ? "border-top pt-3 mt-3" : "")">
                    @if (status.Connected)
                    {
                        <div class="alert alert-info py-2">
                            Beim Verbinden wird die Verbindung zu @ProviderLabel(status.Provider) getrennt und
                            alle geplanten Tasks ab heute in den neuen Kalender geschrieben. Die bisherigen
                            Termine bleiben in @ProviderLabel(status.Provider) stehen.
                        </div>
                    }
                    else if (status.GoogleAvailable)
                    {
                        <div class="mb-3">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="calendarProvider" id="providerGoogle"
                                       checked="@(selectedProvider == CalendarProviders.Google)"
                                       @onchange="() => selectedProvider = CalendarProviders.Google" />
                                <label class="form-check-label" for="providerGoogle">Google</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="calendarProvider" id="providerNextcloud"
                                       checked="@(selectedProvider == CalendarProviders.Nextcloud)"
                                       @onchange="() => selectedProvider = CalendarProviders.Nextcloud" />
                                <label class="form-check-label" for="providerNextcloud">Nextcloud (CalDAV)</label>
                            </div>
                        </div>
                    }

                    @if (selectedProvider == CalendarProviders.Google && status.GoogleAvailable)
                    {
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-primary" href="@ConnectUrl">Mit Google verbinden</a>
                            @if (switching)
                            {
                                <button type="button" class="btn btn-link" @onclick="CancelSwitch">Abbrechen</button>
                            }
                        </div>
                    }
                    else
                    {
                        <form @onsubmit="DiscoverCalDavAsync" @onsubmit:preventDefault="true">
                            <div class="mb-3">
                                <label for="caldavServer" class="form-label">Server-URL</label>
                                <input id="caldavServer" class="form-control" style="max-width: 28rem;"
                                       placeholder="https://cloud.example.org"
                                       autocomplete="off" @bind="caldavServer" />
                            </div>
                            <div class="mb-3">
                                <label for="caldavUser" class="form-label">Benutzername</label>
                                <input id="caldavUser" class="form-control" style="max-width: 28rem;"
                                       autocomplete="off" @bind="caldavUser" />
                            </div>
                            <div class="mb-3">
                                <label for="caldavPassword" class="form-label">App-Passwort</label>
                                <input id="caldavPassword" type="password" class="form-control" style="max-width: 28rem;"
                                       autocomplete="off" @bind="caldavPassword" />
                                <div class="form-text">
                                    In Nextcloud unter <em>Einstellungen → Sicherheit → Geräte &amp; Sitzungen</em>
                                    ein neues App-Passwort erstellen – nicht dein normales Login-Passwort.
                                </div>
                            </div>

                            @if (caldavError is not null)
                            {
                                <div class="alert alert-danger py-2">@caldavError</div>
                            }

                            @if (caldavCalendars is { Count: > 0 })
                            {
                                <div class="mb-3">
                                    <label for="caldavCalendar" class="form-label">Kalender</label>
                                    <select id="caldavCalendar" class="form-select" style="max-width: 28rem;"
                                            @bind="caldavCalendarUrl">
                                        @foreach (var cal in caldavCalendars)
                                        {
                                            <option value="@cal.Url">@cal.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" class="btn @(caldavCalendars is { Count: > 0 } ? "btn-outline-secondary" : "btn-primary")"
                                        disabled="@(caldavBusy || !CalDavCredentialsComplete)">
                                    @(caldavBusy && caldavCalendars is null ? "Suche…" : "Kalender suchen")
                                </button>
                                @if (caldavCalendars is { Count: > 0 })
                                {
                                    <button type="button" class="btn btn-primary" @onclick="ConnectCalDavAsync"
                                            disabled="@(caldavBusy || string.IsNullOrEmpty(caldavCalendarUrl) || !CalDavCredentialsComplete)">
                                        @(caldavBusy ? "Verbinde…" : "Verbinden")
                                    </button>
                                }
                                @if (switching)
                                {
                                    <button type="button" class="btn btn-link" @onclick="CancelSwitch">Abbrechen</button>
                                }
                            </div>
                        </form>
                    }
                </div>
            }
        }
    </div>
</div>

<div class="card mb-3 settings-card">
    <div class="card-header fw-semibold">Azure DevOps</div>
    <div class="card-body">
        <p class="text-muted">
            Verbinde dich per Personal Access Token mit deiner Azure-DevOps-Organisation, um dir
            zugewiesene Work Items als Tasks in ein Projekt zu importieren. Die Verknüpfung
            Projekt ↔ Azure-DevOps-Projekt stellst du im Projekt unter „Bearbeiten“ ein.
        </p>

        @if (azureStatus is null)
        {
            <p class="text-muted mb-0">Status wird geladen…</p>
        }
        else if (azureStatus.Connected)
        {
            <div class="mb-3">
                <span class="badge bg-success">Verbunden</span>
                @if (!string.IsNullOrEmpty(azureStatus.DisplayName))
                {
                    <span class="ms-2">@azureStatus.DisplayName</span>
                }
                <div class="text-muted small mt-1">@azureStatus.OrganizationUrl</div>
            </div>
            <button type="button" class="btn btn-outline-danger" @onclick="DisconnectAzureAsync" disabled="@azureBusy">
                Verbindung trennen
            </button>
        }
        else
        {
            <div class="mb-3">
                <span class="badge bg-secondary">Nicht verbunden</span>
            </div>
            <form @onsubmit="ConnectAzureAsync" @onsubmit:preventDefault="true">
                <div class="mb-2">
                    <label for="azureOrg" class="form-label">Organisations-URL</label>
                    <input id="azureOrg" class="form-control" style="max-width: 28rem;"
                           placeholder="https://dev.azure.com/meine-organisation"
                           autocomplete="off" @bind="azureOrgUrl" />
                </div>
                <div class="mb-2">
                    <label for="azurePat" class="form-label">Personal Access Token</label>
                    <input id="azurePat" type="password" class="form-control" style="max-width: 28rem;"
                           autocomplete="off" @bind="azurePat" />
                    <div class="form-text">
                        Anlegen unter <em>User settings → Personal access tokens</em>. Benötigter Scope:
                        <strong>Work Items (Read)</strong> – für die Projektauswahl zusätzlich
                        <strong>Project and Team (Read)</strong>. Der Token wird verschlüsselt gespeichert.
                    </div>
                </div>
                @if (azureError is not null)
                {
                    <div class="alert alert-danger py-2">@azureError</div>
                }
                <button type="submit" class="btn btn-primary"
                        disabled="@(azureBusy || string.IsNullOrWhiteSpace(azureOrgUrl) || string.IsNullOrWhiteSpace(azurePat))">
                    @(azureBusy ? "Verbinde…" : "Verbinden")
                </button>
            </form>
        }
    </div>
</div>

<div class="card settings-card">
    <div class="card-header fw-semibold">Über</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 fw-normal text-muted">Client-Version</dt>
            <dd class="col-sm-8">@Version.ClientVersionShort</dd>

            <dt class="col-sm-4 fw-normal text-muted">API-Version</dt>
            <dd class="col-sm-8 mb-0">
                @if (Version.ApiVersionShort is { } v)
                {
                    <span>@v</span>
                    @if (Version.ApiVersion?.BuildUtc is { } built)
                    {
                        <span class="text-muted"> · Build @built.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    }
                }
                else
                {
                    <span class="text-muted">nicht erreichbar</span>
                }
            </dd>
        </dl>
    </div>
</div>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "google")]
    public string? GoogleResult { get; set; }

    private CalendarStatusDto? status;
    private bool busy;
    private string newPin = string.Empty;

    // ── Passwort ändern ──────────────────────────────────────────────────────────

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string newPasswordRepeat = string.Empty;
    private string? passwordError;
    private bool passwordBusy;

    // Erst anmeckern, wenn die Wiederholung vollständig sein könnte – nicht beim Tippen
    // des ersten Zeichens.
    private bool RepeatMismatch =>
        newPasswordRepeat.Length >= newPassword.Length && newPassword != newPasswordRepeat;

    private bool CanChangePassword =>
        !passwordBusy
        && currentPassword.Length > 0
        && newPassword.Length > 0
        && newPassword == newPasswordRepeat;

    private async Task ChangePasswordAsync()
    {
        if (!CanChangePassword) return;

        passwordBusy = true;
        passwordError = await Api.ChangePasswordAsync(currentPassword, newPassword);
        passwordBusy = false;

        if (passwordError is not null) return;

        currentPassword = newPassword = newPasswordRepeat = string.Empty;
        Toast.ShowSuccess("Passwort geändert.");
    }

    // Vorlaufzeit der Kalender-Erinnerung; null = keine. Liegt serverseitig, weil die API
    // sie beim Spiegeln braucht – anders als die übrigen Einstellungen auf dieser Seite.
    private int? reminderMinutes;

    // Vollständige Navigation (kein Blazor-Routing) zur API, die den OAuth-Flow startet.
    // Aus der HttpClient-BaseAddress gebaut, damit es auch beim Standalone-Betrieb mit
    // übersteuertem ApiSettings:BaseUrl auf dieselbe API zeigt wie alle Datenaufrufe.
    private string ConnectUrl =>
        $"{Http.BaseAddress?.ToString().TrimEnd('/')}/api/google/connect";

    protected override async Task OnInitializedAsync()
    {
        await AppSettings.EnsureLoadedAsync();
        await JournalLock.EnsureLoadedAsync();
        await Version.EnsureApiLoadedAsync();
        await LoadCalendarStatusAsync();
        azureStatus = await Api.GetAzureDevOpsStatusAsync() ?? new AzureDevOpsStatusDto(false, null, null);

    }

    private async Task OnReminderChanged(ChangeEventArgs e)
    {
        var rohwert = e.Value?.ToString();
        var minuten = string.IsNullOrEmpty(rohwert) ? (int?)null : int.Parse(rohwert);

        if (!await Api.SetCalendarReminderAsync(minuten))
        {
            Toast.ShowError("Erinnerung konnte nicht gespeichert werden.");
            return;
        }

        reminderMinutes = minuten;
        Toast.ShowSuccess("Erinnerung gespeichert");
    }

    // ── Journal-Sperre ───────────────────────────────────────────────────────────

    private async Task SavePinAsync()
    {
        var pin = newPin.Trim();
        if (pin.Length < 4) return;

        await JournalLock.SetPinAsync(pin);
        newPin = string.Empty;
        Toast.ShowSuccess("Journal-PIN gespeichert.");
    }

    private async Task RemovePinAsync()
    {
        // Nachfragen, weil danach jeder am Rechner das Journal öffnen kann.
        var ok = await Confirm.ShowAsync(
            "PIN entfernen?",
            "Das Journal ist danach ohne Eingabe zugänglich.",
            "Entfernen");

        if (!ok) return;

        await JournalLock.SetPinAsync(null);
        Toast.ShowSuccess("Journal-PIN entfernt.");
    }

    private async Task OnTimeoutChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var minutes))
            await JournalLock.SetTimeoutAsync(minutes);
    }

    private async Task OnCalendarViewChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var index))
            await AppSettings.SetCalendarDefaultViewAsync(index);
    }

    private async Task OnSoundsChanged(ChangeEventArgs e)
    {
        if (e.Value is bool enabled)
            await AppSettings.SetSoundsEnabledAsync(enabled);
    }

    private async Task OnSubTasksCollapsedChanged(ChangeEventArgs e)
    {
        if (e.Value is bool collapsed)
            await AppSettings.SetSubTasksCollapsedAsync(collapsed);
    }

    // ── Azure DevOps ─────────────────────────────────────────────────────────────

    private AzureDevOpsStatusDto? azureStatus;
    private string azureOrgUrl = string.Empty;
    private string azurePat = string.Empty;
    private string? azureError;
    private bool azureBusy;

    private async Task ConnectAzureAsync()
    {
        azureBusy = true;
        azureError = null;
        var result = await Api.ConnectAzureDevOpsAsync(new AzureDevOpsConnectDto(azureOrgUrl, azurePat));
        azureBusy = false;

        if (result is null) return; // Netzwerkfehler – Toast kommt vom ApiErrorHandler
        if (!result.Success)
        {
            azureError = result.Error;
            return;
        }

        // Token nicht länger als nötig im Speicher der Seite halten.
        azurePat = string.Empty;
        azureStatus = result.Status;
        Toast.ShowSuccess("Azure DevOps verbunden.");
    }

    private async Task DisconnectAzureAsync()
    {
        var ok = await Confirm.ShowAsync(
            "Azure DevOps trennen?",
            "Der gespeicherte Token wird gelöscht. Importierte Tasks und Projekt-Verknüpfungen bleiben erhalten.",
            "Trennen");
        if (!ok) return;

        azureBusy = true;
        await Api.DisconnectAzureDevOpsAsync();
        azureStatus = await Api.GetAzureDevOpsStatusAsync() ?? new AzureDevOpsStatusDto(false, null, null);
        azureBusy = false;
    }

    // ── Kalender-Synchronisation ─────────────────────────────────────────────────

    // Vor dem Verbinden gewählter Anbieter; beim Wechsel der jeweils andere.
    private string selectedProvider = CalendarProviders.Google;
    private bool switching;

    private string caldavServer = string.Empty;
    private string caldavUser = string.Empty;
    private string caldavPassword = string.Empty;
    private List<CalDavCalendarDto>? caldavCalendars;
    private string? caldavCalendarUrl;
    private string? caldavError;
    private bool caldavBusy;

    private static string ProviderLabel(string? provider) => provider switch
    {
        CalendarProviders.Google => "Google",
        CalendarProviders.Nextcloud => "Nextcloud",
        _ => "Kalender"
    };

    private string OtherProvider =>
        status?.Provider == CalendarProviders.Google ? CalendarProviders.Nextcloud : CalendarProviders.Google;

    // Zu Google wechseln geht nur, wenn der Server Google-Credentials hat.
    private bool OtherProviderAvailable => OtherProvider != CalendarProviders.Google || status?.GoogleAvailable == true;

    private bool CalDavCredentialsComplete =>
        !string.IsNullOrWhiteSpace(caldavServer)
        && !string.IsNullOrWhiteSpace(caldavUser)
        && !string.IsNullOrWhiteSpace(caldavPassword);

    private async Task LoadCalendarStatusAsync()
    {
        status = await Api.GetCalendarStatusAsync();
        switching = false;

        if (status?.Connected == true)
        {
            reminderMinutes = await Api.GetCalendarReminderAsync();
        }
        else if (status is not null && !status.GoogleAvailable)
        {
            // Ohne Google-Credentials auf dem Server bleibt nur Nextcloud.
            selectedProvider = CalendarProviders.Nextcloud;
        }
    }

    private void StartSwitch()
    {
        selectedProvider = OtherProvider;
        switching = true;
    }

    private void CancelSwitch()
    {
        switching = false;
        ResetCalDavForm();
    }

    private void ResetCalDavForm()
    {
        caldavPassword = string.Empty;
        caldavCalendars = null;
        caldavCalendarUrl = null;
        caldavError = null;
    }

    private async Task DiscoverCalDavAsync()
    {
        if (!CalDavCredentialsComplete) return;

        caldavBusy = true;
        caldavError = null;
        caldavCalendars = null;
        var result = await Api.DiscoverCalDavCalendarsAsync(
            new CalDavCredentialsDto(caldavServer, caldavUser, caldavPassword));
        caldavBusy = false;

        if (result is null) return; // Netzwerkfehler – Toast kommt vom ApiErrorHandler
        if (!result.Success)
        {
            caldavError = result.Error;
            return;
        }

        caldavCalendars = result.Calendars;
        // Nextclouds Standardkalender heißt "personal" – sonst der erste in der Liste.
        caldavCalendarUrl = result.Calendars
            .FirstOrDefault(c => c.Url.TrimEnd('/').EndsWith("/personal", StringComparison.OrdinalIgnoreCase))?.Url
            ?? result.Calendars.FirstOrDefault()?.Url;
    }

    private async Task ConnectCalDavAsync()
    {
        if (string.IsNullOrEmpty(caldavCalendarUrl)) return;

        caldavBusy = true;
        caldavError = null;
        var result = await Api.ConnectCalDavAsync(
            new CalDavConnectDto(caldavServer, caldavUser, caldavPassword, caldavCalendarUrl));
        caldavBusy = false;

        if (result is null) return;
        if (!result.Success)
        {
            caldavError = result.Error;
            return;
        }

        // Passwort nicht länger als nötig im Speicher der Seite halten.
        ResetCalDavForm();
        await LoadCalendarStatusAsync();
        Toast.ShowSuccess("Nextcloud-Kalender verbunden. Geplante Tasks werden im Hintergrund übertragen.");
    }

    private async Task DisconnectAsync()
    {
        var ok = await Confirm.ShowAsync(
            $"{ProviderLabel(status?.Provider)} trennen?",
            "Tasks werden nicht mehr in den Kalender geschrieben. Bereits übertragene Termine bleiben dort stehen.",
            "Trennen");
        if (!ok) return;

        busy = true;
        await Api.DisconnectCalendarAsync();
        await LoadCalendarStatusAsync();
        busy = false;
    }
}
