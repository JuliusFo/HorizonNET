<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HorizonNET.Domain\HorizonNET.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Nur die Abstraktion (IDataProtectionProvider) für den Spalten-Konverter;
         eingerichtet wird DataProtection in der API (Program.cs). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" />
    <!-- Identity-Tabellen (Benutzerkonto) leben im selben AppDbContext -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <!-- Override der transitiven SQLitePCLRaw-Pakete (2.1.11) wegen GHSA-2m69-gcr7-jv3q -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
