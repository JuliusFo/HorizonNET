<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <!-- Zieht seit 10.0.15 selbst Microsoft.OpenApi >= 2.13.0; der frühere manuelle
         Override auf 2.7.5 (GHSA-v5pm-xwqc-g5wc) ist damit entfallen. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.15" />
    <!-- UseBlazorFrameworkFiles: Die API liefert den WASM-Client mit aus (Same-Origin,
         ein Prozess für App + Daten – kein CORS, Cookies ohne Sonderbehandlung). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <!-- Betrieb als Windows-Dienst auf dem vServer (UseWindowsService in Program.cs) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lokale Entwicklungs-Secrets (Google-Credentials, Auth:InitialPassword) gehören nicht
         ins Deployment-Paket: In Produktion kommen Secrets als Umgebungsvariablen, und
         Program.cs liest die Datei ohnehin nur in der Development-Umgebung. Ohne diese
         Regel kopiert dotnet publish sie als Content mit nach app\ – so geschehen bis 1.2.0,
         wo sie aus dem ZIP von Hand entfernt werden musste. Gleiches gilt für die
         Development-Einstellungen. -->
    <Content Update="appsettings.Secrets.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\HorizonNET.Shared.Transfer\HorizonNET.Shared.Transfer.csproj" />
    <ProjectReference Include="..\HorizonNET.Domain\HorizonNET.Domain.csproj" />
    <ProjectReference Include="..\HorizonNET.Data\HorizonNET.Data.csproj" />
    <!-- Bringt die gebauten Client-Dateien (wasm/js/css) als Static Web Assets mit -->
    <ProjectReference Include="..\..\Client\HorizonNET.App\HorizonNET.App.csproj" />
  </ItemGroup>

</Project>
