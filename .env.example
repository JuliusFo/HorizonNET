# Vorlage für docker-compose.yml – kopieren nach .env und anpassen.
# .env ist per .gitignore ausgeschlossen (enthält Passwörter).

# Port auf dem Host, optional mit IP. Hinter einem Reverse Proxy auf demselben Host
# nur lokal veröffentlichen: 127.0.0.1:8080
HORIZON_PORT=8080

# Hostnamen bzw. IPs, unter denen die App aufgerufen wird (Semikolon-getrennt), z. B.
# horizon.example.de;192.168.2.40;localhost   –   "*" erlaubt alle (nicht empfohlen)
HORIZON_ALLOWED_HOSTS=localhost;127.0.0.1

# Benutzerkonto für den ersten Start (danach wirkungslos, Passwort in der App ändern).
# Nach dem ersten Start das Passwort hier wieder löschen und den Container neu
# erstellen (docker compose up -d) – sonst bleibt es per "docker inspect" lesbar.
HORIZON_USERNAME=admin
HORIZON_INITIAL_PASSWORD=

# true  = Login nur über HTTPS (hinter einem Reverse Proxy wie Caddy/Traefik/nginx)
# false = Login auch über reines http://server:port (Heimnetz ohne HTTPS)
HORIZON_SECURE_COOKIE=true

# IP oder Netz (CIDR) des Reverse Proxys, dessen X-Forwarded-Header vertraut wird.
# So eng wie möglich: die feste IP des Proxy-Containers (z. B. 172.20.0.10/32) oder
# das eigene Netz, das nur App und Proxy teilen. NICHT pauschal 172.16.0.0/12 – darin
# liegen alle Docker-Netze und je nach Setup auch direkte Zugriffe über das Gateway,
# die damit X-Forwarded-For fälschen und das Login-Rate-Limit umgehen könnten.
# Leer = nur Loopback.
HORIZON_TRUSTED_PROXIES=

# Google-Kalender-Anbindung (optional). Nextcloud/CalDAV wird in der App
# unter Einstellungen verbunden und braucht hier nichts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zeitzone (Tagesgrenzen, Terminserien)
TZ=Europe/Berlin
