# Vorlage für docker-compose.yml – kopieren nach .env und anpassen.
# .env ist per .gitignore ausgeschlossen (enthält Passwörter).

# Port auf dem Host
HORIZON_PORT=8080

# Hostnamen, unter denen die App aufgerufen wird (Semikolon-getrennt), z. B.
# horizon.example.de;localhost   –   "*" erlaubt alle
HORIZON_ALLOWED_HOSTS=*

# Benutzerkonto für den ersten Start (danach wirkungslos, Passwort in der App ändern)
HORIZON_USERNAME=admin
HORIZON_INITIAL_PASSWORD=

# true  = Login nur über HTTPS (hinter einem Reverse Proxy wie Caddy/Traefik/nginx)
# false = Login auch über reines http://server:port (Heimnetz ohne HTTPS)
HORIZON_SECURE_COOKIE=true

# Netz des Reverse Proxys (CIDR), dessen X-Forwarded-Header vertraut wird.
# Docker-Netze liegen standardmäßig in 172.16.0.0/12. Leer = nur Loopback.
HORIZON_TRUSTED_PROXIES=

# Google-Kalender-Anbindung (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zeitzone (Tagesgrenzen, Terminserien)
TZ=Europe/Berlin
